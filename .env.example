# Copie para .env e preencha. Sem as duas primeiras, o app roda em modo demonstração.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# Assinatura: Payment Link do Stripe e portal para cancelar/trocar cartão
VITE_CHECKOUT_URL=
VITE_PORTAL_URL=
VITE_PRECO=R$ 19,90
VITE_DIAS_TESTE=7

# Lembretes: chave pública VAPID (gere com: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=

# Medição: só carregam se a pessoa aceitar os cookies
VITE_GA_ID=
VITE_META_PIXEL_ID=

# Termos e privacidade
VITE_EMPRESA=Télora Produtora
VITE_CNPJ=
VITE_EMAIL_CONTATO=
VITE_CIDADE=Goiânia/GO
